# Environment Variables for QuickDine Backend
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# --- Server ---
PORT=5000

# --- Database ---
# Replace with your own MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/quickdine

# --- JWT Authentication ---
# Use a long, random string for production (e.g., generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# --- Frontend URL (for CORS) ---
CLIENT_URL=http://localhost:5173
